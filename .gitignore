# Local/runtime evidence that may contain device-specific transient data
.local/
tmp/
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Android / Gradle build output
.gradle/
build/
out/
local.properties
*.apk
*.aab
*.jks
*.keystore

# Public upstream ASR runtime downloaded by the pinned M2 bootstrap; not committed
android/mobile-agent/app/libs/*.aar
android/mobile-agent/app/libs/*.partial

# Secrets (never commit)
secrets/
.secrets/
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Git worktrees
.worktrees/

# Benchmark JSON/MD evidence is intentionally tracked unless explicitly sensitive.
