.local/
tmp/
*.log

# IDE/build
.idea/
.vscode/
.gradle/
build/
out/

# Secrets
.env
.env.*
*.key
*.pem
secrets/

# Python
__pycache__/
.venv/

# Public upstream ASR runtime downloaded by the pinned M2 bootstrap; not committed
android/mobile-agent/app/libs/*.aar
android/mobile-agent/app/libs/*.partial

